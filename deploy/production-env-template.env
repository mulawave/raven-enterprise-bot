# =============================================================================
# Raven Enterprise — Production Environment Template
# Copy this file to backend/.env, dashboard/.env, and admin-console/.env
# with values filled in for each respective app.
# =============================================================================

# ── SHARED ────────────────────────────────────────────────────────────────────
NODE_ENV=production

# Database — populated by 01-server-setup.sh output
DATABASE_URL=postgresql://ravenuser:CHANGE_ME@127.0.0.1:5432/ravendb

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_64

# ── BACKEND (backend/.env) ────────────────────────────────────────────────────
PORT=4000

# Sentry — get DSN from sentry.io project settings
SENTRY_DSN=https://YOUR_KEY@oXXXXX.ingest.sentry.io/XXXXXXX
APP_VERSION=1.0.0

# Paystack
PAYSTACK_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXX
PAYSTACK_PUBLIC_KEY=pk_live_XXXXXXXXXXXXXXXXXXXX

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE-XXXXXXXXXXXXXXXXXXXX

# Meta / WhatsApp
META_APP_SECRET=XXXXXXXXXXXXXXXXXXXX
META_VERIFY_TOKEN=XXXXXXXXXXXXXXXXXXXX

# Email (SMTP)
SMTP_HOST=mail.raven-ai.online
SMTP_PORT=587
SMTP_USER=noreply@raven-ai.online
SMTP_PASS=CHANGE_ME

# App URLs
APP_URL=https://app.raven-ai.online
ADMIN_URL=https://admin.raven-ai.online
API_URL=https://api.raven-ai.online

# ── DASHBOARD (dashboard/.env) ────────────────────────────────────────────────
# NEXT_PUBLIC_ variables are embedded at build time
NEXT_PUBLIC_API_URL=https://api.raven-ai.online
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oXXXXX.ingest.sentry.io/XXXXXXX

# ── ADMIN CONSOLE (admin-console/.env) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.raven-ai.online
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oXXXXX.ingest.sentry.io/XXXXXXX
