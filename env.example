# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app_user:change_me@localhost:5432/app_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Meta / WhatsApp / Instagram / Facebook ────────────────────────────────────
META_APP_SECRET=your_meta_app_secret_here
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── Sentry (optional — error monitoring) ─────────────────────────────────────
# Get your DSN from https://sentry.io → Project → Settings → SDK Setup
# Backend (NestJS). Leave blank to disable.
SENTRY_DSN=
# Frontend (Next.js). Same DSN, must start with NEXT_PUBLIC_ to reach the browser.
NEXT_PUBLIC_SENTRY_DSN=
# Version tag attached to each Sentry event for release tracking
APP_VERSION=1.0.0

# ── Next.js frontend API URL ──────────────────────────────────────────────────
# Set to the public API subdomain in production.
# Must be set at BUILD TIME (prefixed NEXT_PUBLIC_).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── reCAPTCHA v2 (Google) ─────────────────────────────────────────────────────
# Register at https://www.google.com/recaptcha/admin → Create v2 "I'm not a robot"
# Add your domain (e.g. app.raven-ai.online) to Allowed Domains.
# Site key goes here (public — safe to expose in browser):
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key stays server-side only (for future backend verification if needed):
# RECAPTCHA_SECRET_KEY=

# ── Production CORS ───────────────────────────────────────────────────────────
# Update for production:
# CORS_ORIGINS=https://app.raven-ai.online,https://admin.raven-ai.online

# ── GitHub Actions deploy secrets (set in repo Settings → Secrets) ─────────────
# DEPLOY_HOST      — server hostname or IP (e.g. raven-ai.online)
# DEPLOY_USER      — cPanel account SSH username
# DEPLOY_SSH_KEY   — private key whose public half is in ~/.ssh/authorized_keys
# DEPLOY_PORT      — SSH port (default 22; cPanel often uses 22 or 2222)
